# ==============================================================================
# MEDIPREDICT AI — ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (root), backend/.env, and apps/web/.env.local respectively.
# NEVER commit real secret keys, service-role keys, or database credentials.
# ==============================================================================

# --- Service Environment ---
PROJECT_NAME="MediPredict AI"
ENVIRONMENT=development
PORT=8000

# --- Cryptography & Session Tokens ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_character_cryptographically_secure_random_hex_string
AUDIT_SIGNING_SECRET=replace_with_separate_hmac_signing_key_for_tamper_evident_audit_logs
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database & PostgreSQL Configuration ---
# Local SQLite default (zero-config development):
DATABASE_URL=sqlite:///./medipredict.db
# Supabase / Production PostgreSQL (uncomment and replace credentials):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.affjbuibhbejzzrwdusw.supabase.co:5432/postgres

# --- Supabase Identity & Storage ---
# Client-safe configuration (can be exposed via NEXT_PUBLIC_*):
NEXT_PUBLIC_SUPABASE_URL=https://affjbuibhbejzzrwdusw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
NEXT_PUBLIC_SUPABASE_PROJECT_REF=affjbuibhbejzzrwdusw

# Server-only Supabase credentials (NEVER expose to browser bundles):
SUPABASE_URL=https://affjbuibhbejzzrwdusw.supabase.co
SUPABASE_KEY=replace_with_supabase_service_role_key_on_backend_only
SUPABASE_JWT_SECRET=replace_with_supabase_jwt_secret_from_api_settings

# --- Rate Limiting & Abuse Prevention ---
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=15
RATE_LIMIT_GENERAL_PER_MINUTE=120

# --- Medical Document Quarantine & Storage ---
MAX_UPLOAD_SIZE_BYTES=15728640

# --- AI Intelligence Providers ---
# Options: clinical_evidence (deterministic offline evidence engine), gemini, openai, local
AI_PROVIDER=clinical_evidence

# Google Gemini / Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Model (Ollama / vLLM / llama.cpp)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# --- Multilingual Voice API (Indian Languages) ---
# Browser Web Speech API is supported out of the box.
# Optional Cloud Streaming Providers:
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# --- Frontend API Proxy & Cloud Deployment URLs ---
# In development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# On Vercel Production:
# Set BACKEND_URL in Vercel to your deployed FastAPI backend URL:
# BACKEND_URL=https://medipredict-backend.onrender.com
# Leave NEXT_PUBLIC_API_URL as /api/v1 (or leave unset) for automatic origin routing:
# NEXT_PUBLIC_API_URL=/api/v1
