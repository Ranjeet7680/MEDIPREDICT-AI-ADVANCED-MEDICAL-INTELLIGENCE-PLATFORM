# MediPredict AI - Environment Configuration Example
# Copy this file to .env and populate credentials

# --- Core Service ---
PROJECT_NAME="MediPredict AI"
ENVIRONMENT=development
SECRET_KEY="generate_a_secure_random_secret_key_here_for_jwt_tokens"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Local SQLite default (zero setup):
DATABASE_URL=sqlite:///./medipredict.db
# Production PostgreSQL with pgvector:
# DATABASE_URL=postgresql://medipredict_admin:medipredict_secure_password_2026@localhost:5432/medipredict

# --- AI Provider Configuration ---
# Options: clinical_evidence (deterministic offline engine), gemini, openai, local
AI_PROVIDER=clinical_evidence

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Inference Endpoint (e.g. Ollama, vLLM)
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
